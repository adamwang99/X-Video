{
  "productName": "X-Video Studio",
  "version": "1.2.0",
  "identifier": "com.aiworld.xvideo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "X-Video Studio — AI World",
        "width": 800,
        "height": 600,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://192.168.1.12:8767 http://localhost:8767; frame-src 'self' http://192.168.1.12:8767 http://localhost:8767"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
