{
  "productName": "X-Video Studio",
  "version": "1.28.3",
  "identifier": "com.aiworld.xvideo",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8767 http://localhost:8769 http://127.0.0.1:8769; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; img-src 'self' data: https://*.googleusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../backend/server.py",
      "../backend/voice_library.py",
      "../backend/xvideo_scenes.py",
      "../backend/xvideo_storyboard.py",
      "../backend/xvideo_pexels.py",
      "../backend/xvideo_apikeys.py",
      "../requirements.txt",
      "../backend/xvideo_scene_analyzer.py",
      "../backend/xvideo_scene_templates.py",
      "../backend/xvideo_hv.py",
      "../backend/hv_templates_catalog.json"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}